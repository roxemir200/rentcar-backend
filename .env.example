# ============================================================
#  MODELE - a copier en .env a la racine du projet
#
#      cp .env.example .env
#
#  Lu automatiquement par docker compose. Le fichier .env est
#  ignore par Git ; ce modele-ci est commite et ne contient
#  aucune valeur reelle.
# ============================================================

# ---------- Base de donnees du conteneur MySQL ----------
MYSQL_ROOT_PASSWORD=rootpwd
MYSQL_DATABASE=rentcar_db

# ---------- Securite ----------
# Generer avec :  openssl rand -base64 48
# JJWT exige au moins 32 octets pour signer en HS256.
JWT_SECRET=REMPLACER_PAR_UNE_CLE_ALEATOIRE
JWT_EXPIRATION=3600000

# ---------- Stripe (mode test) ----------
STRIPE_SECRET_KEY=sk_test_REMPLACER
STRIPE_WEBHOOK_SECRET=whsec_REMPLACER

# ---------- Stockage des images ----------
# "local" en developpement, "cloudinary" en production : le disque d'un
# conteneur est efface a chaque redeploiement.
STORAGE_PROVIDER=local

# Format : cloudinary://cle:secret@nom-du-compte (tableau de bord Cloudinary)
CLOUDINARY_URL=

# ---------- Mail ----------
# "smtp" en local, "brevo" en production : les hebergeurs bloquent
# generalement les ports SMTP sortants (25, 465, 587).
MAIL_TRANSPORT=smtp

# Transport "brevo" — cle API (section SMTP & API > API Keys de Brevo).
# Differente de la cle SMTP : celle-ci commence par xkeysib-.
BREVO_API_KEY=

# Adresse d'expedition. Elle doit etre VALIDEE dans Brevo (section Senders),
# sinon l'API repond 400 meme avec une cle correcte.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=RentCar

# Transport "smtp" uniquement
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=REMPLACER
MAIL_PASSWORD=REMPLACER

# ---------- URLs, sans barre oblique finale ----------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
