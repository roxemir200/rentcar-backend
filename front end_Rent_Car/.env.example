# ============================================================
#  MODELE - a copier en .env.local pour le developpement
#
#      cp .env.example .env.local
#
#  .env.local est ignore par Git. Ce modele-ci est commite :
#  il documente les variables attendues sans en reveler aucune.
#
#  /!\ Vite fige ces valeurs au moment du BUILD, pas a
#  l'execution. Les changer impose de reconstruire. Dans une
#  image Docker, elles se passent en ARG a `docker build`,
#  jamais en variables de `docker run`.
# ============================================================

# Origine du backend, SANS barre oblique finale ni chemin.
#   developpement : http://localhost:8089
#   production    : https://mon-backend.onrender.com
VITE_API_URL=http://localhost:8089

# Cle publiable Stripe. Publique par conception : elle est
# destinee au navigateur. Ne jamais mettre ici la cle secrete
# (sk_...), qui appartient exclusivement au backend.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REMPLACER
